{
  "name": "cecil/theme-installer",
  "description": "Composer installer for Cecil's themes",
  "type": "composer-plugin",
  "keywords": [
    "cecil",
    "composer-plugin",
    "installer",
    "themes"
  ],
  "homepage": "https://cecil.app",
  "license": "MIT",
  "authors": [
    {
      "name": "Arnaud Ligny",
      "email": "arnaud@ligny.fr",
      "homepage": "https://arnaudligny.fr",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "composer-plugin-api": "^2.0"
  },
  "require-dev": {
    "composer/composer": "^2.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Cecil\\Installer\\Composer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cecil\\Installer\\Composer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "class": "Cecil\\Installer\\Composer\\CecilPlugin",
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
